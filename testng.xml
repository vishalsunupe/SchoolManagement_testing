<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="School Management Automation Suite" verbose="1" parallel="classes" thread-count="2">

    <!-- Global TestNG Listeners -->
    <listeners>
        <listener class-name="listeners.TestListener"/>
        <listener class-name="listeners.AnnotationTransformer"/>
    </listeners>

    <!-- Suite-level default browser selection parameter -->
    <parameter name="browser" value="chrome"/>

    <test name="Functionality Tests">
        <classes>
            <class name="tests.LoginTest"/>
            <class name="tests.AddTeacherTest"/>
            <class name="tests.LoginTestDataDriven"/>
             <class name="tests. AddStudentTest"/>
            
           
        </classes>
    </test>
</suite>
